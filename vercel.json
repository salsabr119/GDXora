{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "crons": [
    {
      "path": "/api/cron/webhooks",
      "schedule": "0 3 * * *"
    }
  ],
  "functions": {
    "api/zatca/*.js": {
      "maxDuration": 60
    },
    "api/cron/*.js": {
      "maxDuration": 60
    },
    "api/assistant.js": {
      "maxDuration": 60,
      "includeFiles": "docs/USER_MANUAL.md"
    }
  }
}
